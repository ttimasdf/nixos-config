{ flake, ... }:

final: prev:
{
  aliyun-cli = prev.aliyun-cli.overrideAttrs (oldAttrs: rec {
    pname = "aliyun-cli";
    version = "3.2.2";

    src = final.lib.trace "FYI: aliyun-cli pinned to ${version}" prev.fetchFromGitHub {
        owner = "aliyun";
        repo = "aliyun-cli";
        tag = "v${version}";
        hash = "sha256-lmlCPBEqopmoNjkihVOh8zKSKsS4HmaDQ+QAEJ/pEvA=";
        fetchSubmodules = true;
    };
  });
}
