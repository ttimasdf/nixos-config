{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "nixos-rebuild",
            "type": "shell",
            "command": "sudo git -C /etc/nixos reset --hard && sudo git -C /etc/nixos pull --rebase && sudo https_proxy=$https_proxy NIXOS_LABEL_SUFFIX=\"${input:labelSuffix}\" nixos-rebuild switch --impure --show-trace --verbose && cp /etc/nixos/*.lock .",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "labelSuffix",
            "type": "promptString",
            "description": "NixOS label suffix"
        }
    ]
}