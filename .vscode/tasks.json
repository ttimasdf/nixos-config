{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build nixos system",
            "type": "shell",
            "command": ["just", "build"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "update version hint",
            "type": "shell",
            "command": ["just", "version-hint", "${input:versionHint}"],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "versionHint",
            "type": "promptString",
            "description": "NixOS version hint"
        }
    ]
}