{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "nixos-rebuild",
            "type": "shell",
            "command": "branch=\"$(git rev-parse --abbrev-ref HEAD)\"; sudo git -C /etc/nixos reset --hard && sudo git -C /etc/nixos fetch --all && sudo git -C /etc/nixos checkout \"$branch\" && sudo git -C /etc/nixos pull --rebase && nixos-rebuild switch --show-trace --verbose --sudo && cp /etc/nixos/*.lock .",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "update version hint",
            "type": "shell",
            "command": "printf '${input:versionHint}' > nixos-version-hint.txt && git add nixos-version-hint.txt",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "versionHint",
            "type": "promptString",
            "description": "NixOS version hint"
        }
    ]
}