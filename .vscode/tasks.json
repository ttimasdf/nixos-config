{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Update version hint",
            "type": "shell",
            "command": ["xc", "version-hint", "${input:versionHint}"],
            "problemMatcher": []
        },
        {
            "label": "Build NixOS system",
            "type": "shell",
            "command": ["xc", "build"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Test NixOS system build",
            "type": "shell",
            "command": ["xc", "test"],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "versionHint",
            "type": "promptString",
            "description": "NixOS version hint"
        }
    ]
}