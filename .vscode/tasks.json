{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "nixos-rebuild",
            "type": "shell",
            "command": "printf '${input:labelSuffix}' > nixos-label-suffix.txt && nix run ; git checkout nixos-label-suffix.txt",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "labelSuffix",
            "type": "promptString",
            "description": "NixOS label suffix"
        }
    ]
}