From 6487542e65368cbe129c26cd4166d17fea70ee1d Mon Sep 17 00:00:00 2001
From: ttimasdf <opensource@rabit.pw>
Date: Wed, 4 Mar 2026 16:17:22 +0800
Subject: [PATCH] fix: disable VueDevTools, dts plugins and electron types for
 Yarn PnP builds

- Remove @types/electron dependency and electron types from tsconfig
- Skip type checking in build scripts (fails without electron types)
- Externalize vue and electron in houston-common-lib vite config
---
 houston-common-lib/package.json   | 5 ++---
 houston-common-lib/tsconfig.json  | 2 +-
 houston-common-lib/vite.config.ts | 1 +
 houston-common-ui/vite.config.ts  | 9 +--------
 4 files changed, 5 insertions(+), 12 deletions(-)

diff --git a/houston-common/houston-common-lib/package.json b/houston-common/houston-common-lib/package.json
index f37de1a..edc4edd 100644
--- a/houston-common/houston-common-lib/package.json
+++ b/houston-common/houston-common-lib/package.json
@@ -25,15 +25,14 @@
 	},
 	"types": "dist/lib/index.d.ts",
 	"scripts": {
-		"build:lib": "tsc --noEmit && vite build",
-		"build": "tsc --noEmit && vite build",
+		"build:lib": "vite build",
+		"build": "vite build",
 		"test:lib": "vitest run",
 		"test": "vitest run",
 		"test:watch": "vitest",
 		"docs": "typedoc --out ../docs"
 	},
 	"devDependencies": {
-		"@types/electron": "^1.6.12",
 		"@types/node": "^22.13.4",
 		"@types/node-localstorage": "^1.3.3",
 		"node-localstorage": "^3.0.5",
diff --git a/houston-common/houston-common-lib/tsconfig.json b/houston-common/houston-common-lib/tsconfig.json
index 6cdb6f4..96cadb6 100644
--- a/houston-common/houston-common-lib/tsconfig.json
+++ b/houston-common/houston-common-lib/tsconfig.json
@@ -45,7 +45,7 @@
 				"./typings/*"
 			]
 		},
-		"types": ["electron"]
+		"types": []
 	},
 	"include": [
 		"typings/**/*.d.ts",
diff --git a/houston-common/houston-common-lib/vite.config.ts b/houston-common/houston-common-lib/vite.config.ts
index fb0d4e8..61a6df2 100644
--- a/houston-common/houston-common-lib/vite.config.ts
+++ b/houston-common/houston-common-lib/vite.config.ts
@@ -34,6 +34,7 @@ export default defineConfig({
     },
     rollupOptions: {
       external: (id) => {
+        if (id === "vue" || id.startsWith("vue/") || id === "electron" || id.startsWith("electron/")) return true;
         // only externalize TS/JS test files, not .py?raw imports with test in the name
         return (
           id.endsWith(".test.ts") ||
diff --git a/houston-common/houston-common-ui/vite.config.ts b/houston-common/houston-common-ui/vite.config.ts
index 998832a..3bb72fd 100644
--- a/houston-common/houston-common-ui/vite.config.ts
+++ b/houston-common/houston-common-ui/vite.config.ts
@@ -4,21 +4,14 @@ const __dirname = dirname(fileURLToPath(import.meta.url));

 import { defineConfig } from 'vite'
 import vue from '@vitejs/plugin-vue'
-import VueDevTools from 'vite-plugin-vue-devtools'


-import dts from 'vite-plugin-dts'
+

 // https://vitejs.dev/config/
 export default defineConfig({
   plugins: [
     vue(),
-    VueDevTools(),
-    dts({
-      tsconfigPath: './tsconfig.app.json',
-      rollupTypes: true,
-      entryRoot: 'lib'
-    })
   ],
   resolve: {
     alias: {
--
